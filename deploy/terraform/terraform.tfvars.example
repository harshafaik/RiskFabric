# AWS Deployment Configurations
aws_region    = "us-east-1"
instance_type = "t3.small"

# --- REQUIRED: Your local public IP (CIDR format) ---
# Run `curl ifconfig.me` and append `/32` (e.g. "203.0.113.50/32")
my_ip = "CHANGE_ME/32"

# --- SSH Configurations ---
# Defaults to your local default SSH key path. Change if you use a custom key pair.
# public_key_path = "~/.ssh/id_rsa.pub"
